---
import MainLayout from "../layouts/MainLayout.astro";

const skillGroups = [
  { label: "Languages", items: ["Python", "JavaScript", "TypeScript", "Java", "SQL"] },
  { label: "Data Science", items: ["EDA", "Feature Engineering", "LightGBM Tuning", "Pandas", "Scikit-Learn"] },
  { label: "Frontend", items: ["Next.js", "React", "React Native", "Astro", "Tailwind CSS"] },
  { label: "Backend", items: ["FastAPI", "Spring Boot", "PostgreSQL", "MySQL", "JWT / OAuth", "Networking"] },
  { label: "Platforms & Infrastructure", items: ["Databricks", "Render", "Supabase", "Neon", "trigger.dev", "Docker"] },
  { label: "Testing", items: ["Unit Testing", "Integration Testing", "Smoke Testing"] },
  { label: "Tools", items: ["Git", "GitHub"] },
];

const competencies = [
  {
    title: "Analysis & Understanding",
    points: [
      "Surface data quality issues, distributions, and relationships through EDA before any modeling begins",
      "Turn raw, messy datasets into structured, actionable insight",
    ],
  },
  {
    title: "Data & Feature Engineering",
    points: [
      "Build clean, reproducible preprocessing pipelines that transform raw data into modeling-ready form",
      "Craft both domain-driven and technique-driven features to represent data effectively",
    ],
  },
  {
    title: "Machine Learning",
    points: [
      "Develop and tune gradient-boosted tree models, with a focus on LightGBM",
      "Apply predictive analytics to real-world signals like equipment health, finances, and anomalies",
    ],
  },
  {
    title: "Production-Grade Engineering",
    points: [
      "Treat models and pipelines with production rigor, including unit testing rather than notebook-only work",
      "Ship data products end-to-end across frontend and backend",
    ],
  },
];

const featuredProjects = [
  {
    title: "AOG Zero — Aircraft-on-Ground Prevention System",
    description: "A hackathon project built for Honeywell, monitoring Auxiliary Power Unit (APU) health across a fleet to predict and prevent aircraft-on-ground incidents.",
    details: [
      "Stack: Next.js/TypeScript (frontend dashboard), FastAPI + PostgreSQL (backend, predictive analytics)",
      "Contribution: Worked across both the frontend dashboard and backend predictive analytics system",
      "Team: Collaborated with a multi-person team in a hackathon setting",
    ],
    url: "https://github.com/SRVSRR/aog-zero",
  },
  {
    title: "Expense Tracker & Predictor (Mobile App)",
    description: "A mobile application combining data science with mobile development, designed as part of a personal software product line.",
    details: [
      "Stack: React Native",
      "Features: Logs spending, forecasts end-of-month balance, flags anomalous transactions, and suggests budget adjustments",
      "Focus: Applying spending prediction and anomaly detection models within a consumer-facing mobile experience",
    ],
    url: "https://github.com/SRVSRR",
  },
  {
    title: "Student Administration System",
    description: "A full-stack student administration system with role-based access, assessments, marks, and PDF report generation.",
    details: [
      "Stack: Next.js 15 + TypeScript frontend, Spring Boot + Java 17 backend, PostgreSQL",
      "Features: Three-role RBAC (Admin/Teacher/Student), assessment weighting rules, client-side PDF reports",
      "Grade: A+ in CS241 Software Design and Implementation",
    ],
    url: "https://github.com/SRVSRR/student-administration-system",
  },
  {
    title: "TCP File Transfer Protocol",
    description: "A custom request/response file-transfer protocol hand-rolled on raw TCP sockets in Python.",
    details: [
      "Stack: Python standard library only (socket, os), no dependencies",
      "Features: Text-control framing, binary payload streaming, path-traversal protection on both sides",
      "Grade: A in CS310 Computer Networking",
    ],
    url: "https://github.com/SRVSRR/CS310-Client-Server-TCP-File-Transfer",
  },
];
---
<MainLayout
  title="Skills & Expertise"
  description="Rohan Nandan's skills and expertise in data science, data engineering, machine learning, and full-stack software engineering."
>
  <section class="mb-16">
    <h2 class="text-3xl font-extrabold text-white mb-2 text-center">Skills</h2>
    <p class="text-muted text-center mb-10">Languages, frameworks, and tools I work with</p>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {skillGroups.map((group) => (
        <div class="bg-secondary border border-soft rounded-xl p-6">
          <h3 class="text-lg font-semibold text-white mb-3">{group.label}</h3>
          <ul class="space-y-2 text-muted text-sm list-disc pl-5">
            {group.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <section class="mb-16">
    <h2 class="text-3xl font-extrabold text-white mb-2 text-center">Core Competencies</h2>
    <p class="text-muted text-center mb-10">How I apply these skills in practice</p>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {competencies.map((competency) => (
        <div class="bg-secondary border border-soft rounded-xl p-6">
          <h3 class="text-lg font-semibold text-white mb-3">{competency.title}</h3>
          <ul class="space-y-2 text-muted text-sm list-disc pl-5">
            {competency.points.map((point) => (
              <li>{point}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <section class="mb-8">
    <h2 class="text-3xl font-extrabold text-white mb-2 text-center">Featured Projects</h2>
    <p class="text-muted text-center mb-10">Projects that put these skills to work</p>
    <div class="flex flex-col gap-6">
      {featuredProjects.map((project) => (
        <div class="bg-secondary border border-soft rounded-xl p-6">
          <h3 class="text-lg font-semibold text-white mb-2">{project.title}</h3>
          <p class="text-muted text-sm leading-relaxed">{project.description}</p>
          <ul class="mt-4 space-y-2 text-muted text-sm list-disc pl-5">
            {project.details.map((detail) => (
              <li>{detail}</li>
            ))}
          </ul>
          <a href={project.url} target="_blank" rel="noopener noreferrer" class="inline-block mt-4 text-sm text-accent hover:underline">View project</a>
        </div>
      ))}
    </div>
  </section>
</MainLayout>
