---
import MainLayout from "../../layouts/MainLayout.astro";
import Tags from "../../components/Tags.astro";
import RelatedPosts from "../../components/RelatedPosts.astro";
import ShareButtons from "../../components/ShareButtons.astro";
import TableOfContents from "../../components/TableOfContents.astro";
import { getCollection } from 'astro:content';
import { formatDate, calculateReadTime, capitalize, slugify } from "../../utils";
import { getImageDims } from "../../image-dims";
import { SITE_TITLE } from "../../constants";

export async function getStaticPaths() {
  const allBlogArticles = await getCollection('blog');
  return allBlogArticles.map(entry => ({
    params: { slug: entry.slug },
    props: { entry, allEntries: allBlogArticles },
  }));
}

const { entry, allEntries } = Astro.props;

if(entry === undefined) {
  return Astro.redirect('/404');
}

const { Content, headings } = await entry.render();

// Generate description from content if not provided
const description = entry.data.description || `${entry.data.title} - Written by ${entry.data.author}. Learn about ${entry.data.tags.join(', ')}.`;
const imagePath = `/images/${entry.data.image}`;
const siteUrl = Astro.site ?? new URL(Astro.url.origin);
const articleUrl = new URL(Astro.url.pathname, siteUrl).toString();
const imageUrl = new URL(imagePath, siteUrl).toString();

const publishedTime = entry.data.pubDate.toISOString();
const firstTag = entry.data.tags[0] ?? null;
const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: new URL('/', siteUrl).toString(),
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Articles',
      item: new URL('/articles', siteUrl).toString(),
    },
    ...(firstTag
      ? [
          {
            '@type': 'ListItem',
            position: 3,
            name: capitalize(firstTag),
            item: new URL(`/articles/tag/${slugify(firstTag)}`, siteUrl).toString(),
          },
        ]
      : []),
    {
      '@type': 'ListItem',
      position: firstTag ? 4 : 3,
      name: entry.data.title,
      item: articleUrl,
    },
  ],
};
const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: entry.data.title,
  description,
  image: [imageUrl],
  datePublished: publishedTime,
  author: {
    '@type': 'Person',
    name: entry.data.author,
  },
  publisher: {
    '@type': 'Organization',
    name: SITE_TITLE,
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': articleUrl,
  },
};

// Calculate read time
const readTime = calculateReadTime(entry.body);
const coverDims = getImageDims(entry.data.image);
---

<MainLayout
  title={entry.data.title}
  description={description}
  image={imagePath}
  type="article"
  publishedTime={publishedTime}
  author={entry.data.author}
  jsonLd={[articleJsonLd, breadcrumbJsonLd]}
>
  <div id="reading-progress" class="fixed top-0 left-0 h-1 bg-accent z-50 w-0"></div>
  <nav aria-label="Breadcrumb" class="text-sm text-muted mb-4">
    <ol class="flex flex-wrap items-center gap-2">
      <li><a href="/" class="hover:text-accent transition-colors">Home</a></li>
      <li aria-hidden="true">›</li>
      <li><a href="/articles" class="hover:text-accent transition-colors">Articles</a></li>
      {firstTag && (
        <>
          <li aria-hidden="true">›</li>
          <li><a href={'/articles/tag/' + slugify(firstTag)} class="hover:text-accent transition-colors">{capitalize(firstTag)}</a></li>
        </>
      )}
      <li aria-hidden="true">›</li>
      <li class="text-slate-100 truncate">{entry.data.title}</li>
    </ol>
  </nav>
  <article id="article-content" class="max-w-3xl mx-auto lg:max-w-[70%]">
      <h1 class="text-4xl font-bold mb-2 text-white"> {entry.data.title}</h1>
      <p class="text-lg mb-2 text-muted">Written by {entry.data.author} on {formatDate(entry.data.pubDate)} · {readTime}</p>
      <Tags tags={entry.data.tags} />
      <img src={imagePath} alt="Article Image" width={coverDims.width} height={coverDims.height} loading="eager" fetchpriority="high" decoding="async" class="w-full h-auto rounded-xl my-6 border border-soft" />
      <Content />
  </article>
  <div class="max-w-3xl mx-auto lg:max-w-[70%]">
    <ShareButtons url={articleUrl} title={entry.data.title} />
  </div>
  <TableOfContents headings={headings} />

  <RelatedPosts currentEntry={entry} allEntries={allEntries} />
</MainLayout>

<style is:global>
  article p {
    margin: 20px 0;
  }

  article h2 {
    margin: 20px 0;
    font-size: 1.8rem;
  }

  article h3 {
    margin-top: 32px;
    margin-bottom: 16px;
    font-size: 1.5rem;
  }

  article ul {
    list-style-type: disc;
    margin: 16px 0;
    padding-left: 24px;
  }

  article ol {
    list-style-type: decimal;
    margin: 16px 0;
    padding-left: 24px;
  }

  article li {
    margin: 8px 0;
  }

  article strong {
    font-weight: 700;
  }

  article a:not(.tag-link) {
    color: #f97316;
    text-decoration: none;
    font-weight: 600;
    border-radius: 4px;
    padding: 0 0.15em;
    transition: color 0.2s ease, background-color 0.2s ease;
  }

  article a:not(.tag-link):hover {
    color: #fdba74;
    background-color: rgba(249, 115, 22, 0.15);
  }

  article a:not(.tag-link):focus-visible {
    outline: 2px solid #f97316;
    outline-offset: 2px;
    background-color: rgba(249, 115, 22, 0.2);
  }

  article a.tag-link:focus-visible {
    outline: 2px solid #f97316;
    outline-offset: 2px;
    border-radius: 999px;
  }

  article code {
    background-color: rgba(255, 255, 255, 0.1);
    padding: 2px 6px;
    border-radius: 4px;
    font-family: monospace;
  }

  article pre {
    position: relative;
    background-color: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    padding: 16px;
    overflow-x: auto;
  }

  article pre code {
    background-color: transparent;
    padding: 0;
  }

  .copy-code-button {
    position: absolute;
    top: 8px;
    right: 8px;
    font-size: 0.75rem;
    padding: 4px 10px;
    border-radius: 8px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background-color: #1b2a44;
    color: #a7b4c8;
    cursor: pointer;
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .copy-code-button:hover {
    color: #f97316;
    border-color: #f97316;
  }

  article blockquote {
    border-left: 4px solid #6366f1;
    padding-left: 16px;
    margin: 20px 0;
    font-style: italic;
    color: #a1a1aa;
  }

  article table {
    width: 100%;
    border-collapse: collapse;
    margin: 24px 0;
    font-size: 0.95rem;
    overflow-x: auto;
    display: block;
  }

  article thead {
    background-color: rgba(99, 102, 241, 0.2);
  }

  article th {
    padding: 12px 16px;
    text-align: left;
    font-weight: 600;
    border-bottom: 2px solid #6366f1;
    color: #e2e8f0;
  }

  article td {
    padding: 12px 16px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  article tr:hover {
    background-color: rgba(255, 255, 255, 0.05);
  }

  article tbody tr:last-child td {
    border-bottom: none;
  }

  /* Inline images in markdown content */
  article .content-body img,
  article > p img,
  article p img {
    width: 100%;
    max-height: 100%;
    object-fit: contain;
    border-radius: 12px;
    margin: 24px 0;
    display: block;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  /* Small image - use ![alt|small](/images/file.webp) */
  article img[alt*="|small"] {
    width: 40%;
    max-height: 40%;
    margin-left: auto;
    margin-right: auto;
  }

  /* Medium image - use ![alt|medium](/images/file.webp) */
  article img[alt*="|medium"] {
    width: 65%;
    max-height: 65%;
    margin-left: auto;
    margin-right: auto;
  }

  /* Large image - use ![alt|large](/images/file.webp) */
  article img[alt*="|large"] {
    width: 85%;
    max-height: 85%;
    margin-left: auto;
    margin-right: auto;
  }

  /* Left aligned - use ![alt|left](/images/file.webp) */
  article img[alt*="|left"] {
    float: left;
    margin: 8px 24px 16px 0;
  }

  /* Right aligned - use ![alt|right](/images/file.webp) */
  article img[alt*="|right"] {
    float: right;
    margin: 8px 0 16px 24px;
  }

  /* Center aligned (default) - use ![alt|center](/images/file.webp) */
  article img[alt*="|center"] {
    margin-left: auto;
    margin-right: auto;
  }

  /* Clear floats after floated images */
  article p:has(img[alt*="|left"]) + p,
  article p:has(img[alt*="|right"]) + p {
    clear: both;
  }

  /* Image caption styling - put text in italics right after image */
  article p img + br + em,
  article p:has(> img:only-child) + p em:only-child {
    display: block;
    text-align: center;
    color: #a1a1aa;
    font-size: 0.9rem;
    margin-top: -16px;
    margin-bottom: 24px;
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const bar = document.getElementById('reading-progress');
    const article = document.getElementById('article-content');
    if (bar && article) {
      const update = () => {
        const total = article.offsetHeight - window.innerHeight;
        const progress = total > 0 ? Math.min(Math.max(-article.getBoundingClientRect().top / total, 0), 1) : 0;
        bar.style.width = `${progress * 100}%`;
      };
      update();
      document.addEventListener('scroll', update, { passive: true });
    }
  });

  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('article pre').forEach((block) => {
      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'copy-code-button';
      button.textContent = 'Copy';
      button.setAttribute('aria-label', 'Copy code to clipboard');

      button.addEventListener('click', async () => {
        const code = block.querySelector('code');
        const text = code ? code.innerText : block.innerText;
        try {
          await navigator.clipboard.writeText(text);
        } catch {
          const textarea = document.createElement('textarea');
          textarea.value = text;
          document.body.appendChild(textarea);
          textarea.select();
          document.execCommand('copy');
          document.body.removeChild(textarea);
        }
        button.textContent = 'Copied ✓';
        setTimeout(() => {
          button.textContent = 'Copy';
        }, 2000);
      });

      block.appendChild(button);
    });
  });
</script>