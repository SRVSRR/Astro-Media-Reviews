---
import MainLayout from "../../layouts/MainLayout.astro";
import Tags from "../../components/Tags.astro";
import { getEntry } from 'astro:content';
import { formatDate } from "../../utils";

const { slug } = Astro.params;

const normalizedSlug = Array.isArray(slug) ? slug.join('/') : slug;

if(!normalizedSlug) {
  throw new Error('Slug is required');
}

const entry = await getEntry('blog', normalizedSlug);

if(entry === undefined) {
  return Astro.redirect('/404');
}

const { Content } = await entry.render();
---

<MainLayout>
  <article class="max-w-3xl mx-auto lg:max-w-[70%]">
    <h1 class="text-4xl font-bold mb-2 text-white"> {entry.data.title}</h1>
    <h3 class="text-lg mb-2 text-muted">Written by {entry.data.author} on {formatDate(entry.data.pubDate)}</h3>
    <Tags tags={entry.data.tags} />
    <img src={'/images/' + entry.data.image} alt="Article Image" class="w-full h-auto rounded-xl my-6 border border-soft" />
    <Content />
  </article>
</MainLayout>

<style is:global>
  article p {
    margin: 20px 0;
  }

  article h2 {
    margin: 20px 0;
    font-size: 1.8rem;
  }

  article h3 {
    margin-top: 32px;
    margin-bottom: 16px;
    font-size: 1.5rem;
  }

  article ul {
    list-style-type: disc;
    margin: 16px 0;
    padding-left: 24px;
  }

  article ol {
    list-style-type: decimal;
    margin: 16px 0;
    padding-left: 24px;
  }

  article li {
    margin: 8px 0;
  }

  article strong {
    font-weight: 700;
  }

  article code {
    background-color: rgba(255, 255, 255, 0.1);
    padding: 2px 6px;
    border-radius: 4px;
    font-family: monospace;
  }

  article blockquote {
    border-left: 4px solid #6366f1;
    padding-left: 16px;
    margin: 20px 0;
    font-style: italic;
    color: #a1a1aa;
  }
</style>