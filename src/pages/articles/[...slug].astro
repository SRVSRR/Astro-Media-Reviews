---
import MainLayout from "../../layouts/MainLayout.astro";
import Tags from "../../components/Tags.astro";
import { getCollection, getEntry } from 'astro:content';
import { formatDate, calculateReadTime } from "../../utils";
import { SITE_TITLE } from "../../constants";

export async function getStaticPaths() {
  const allBlogArticles = await getCollection('blog');
  return allBlogArticles.map(entry => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { slug } = Astro.params;
const { entry } = Astro.props;

if(entry === undefined) {
  return Astro.redirect('/404');
}

const { Content } = await entry.render();

// Generate description from content if not provided
const description = entry.data.description || `${entry.data.title} - Written by ${entry.data.author}. Learn about ${entry.data.tags.join(', ')}.`;
const imagePath = `/images/${entry.data.image}`;
const siteUrl = Astro.site ?? new URL(Astro.url.origin);
const articleUrl = new URL(Astro.url.pathname, siteUrl).toString();
const imageUrl = new URL(imagePath, siteUrl).toString();
const latestArticles = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .filter(a => a.slug !== normalizedSlug) // Don't show current article
  .slice(0, 3); // Get top 3

const publishedTime = entry.data.pubDate.toISOString();
const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: entry.data.title,
  description,
  image: [imageUrl],
  datePublished: publishedTime,
  author: {
    '@type': 'Person',
    name: entry.data.author,
  },
  publisher: {
    '@type': 'Organization',
    name: SITE_TITLE,
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': articleUrl,
  },
};

const customLd = articleJsonLd;

// Calculate read time
const readTime = calculateReadTime(entry.body);
---

<MainLayout
  title={entry.data.title}
  description={description}
  image={imagePath}
  type="article"
  publishedTime={publishedTime}
  author={entry.data.author}
  jsonLd={articleJsonLd}
>
  <article class="max-w-3xl mx-auto lg:max-w-[70%]">
    <h1 class="text-4xl font-bold mb-2 text-white"> {entry.data.title}</h1>
    <h3 class="text-lg mb-2 text-muted">Written by {entry.data.author} on {formatDate(entry.data.pubDate)} · {readTime}</h3>
    <Tags tags={entry.data.tags} />
    <img src={imagePath} alt="Article Image" class="w-full h-auto rounded-xl my-6 border border-soft" />
    <Content />
  </article>
</MainLayout>

<style is:global>
  article p {
    margin: 20px 0;
  }

  article h2 {
    margin: 20px 0;
    font-size: 1.8rem;
  }

  article h3 {
    margin-top: 32px;
    margin-bottom: 16px;
    font-size: 1.5rem;
  }

  article ul {
    list-style-type: disc;
    margin: 16px 0;
    padding-left: 24px;
  }

  article ol {
    list-style-type: decimal;
    margin: 16px 0;
    padding-left: 24px;
  }

  article li {
    margin: 8px 0;
  }

  article strong {
    font-weight: 700;
  }

  article code {
    background-color: rgba(255, 255, 255, 0.1);
    padding: 2px 6px;
    border-radius: 4px;
    font-family: monospace;
  }

  article blockquote {
    border-left: 4px solid #6366f1;
    padding-left: 16px;
    margin: 20px 0;
    font-style: italic;
    color: #a1a1aa;
  }

  article table {
    width: 100%;
    border-collapse: collapse;
    margin: 24px 0;
    font-size: 0.95rem;
    overflow-x: auto;
    display: block;
  }

  article thead {
    background-color: rgba(99, 102, 241, 0.2);
  }

  article th {
    padding: 12px 16px;
    text-align: left;
    font-weight: 600;
    border-bottom: 2px solid #6366f1;
    color: #e2e8f0;
  }

  article td {
    padding: 12px 16px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  article tr:hover {
    background-color: rgba(255, 255, 255, 0.05);
  }

  article tbody tr:last-child td {
    border-bottom: none;
  }

  /* Inline images in markdown content */
  article .content-body img,
  article > p img,
  article p img {
    width: 100%;
    max-height: 100%;
    object-fit: contain;
    border-radius: 12px;
    margin: 24px 0;
    display: block;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  /* Small image - use ![alt|small](/images/file.webp) */
  article img[alt*="|small"] {
    width: 40%;
    max-height: 40%;
    margin-left: auto;
    margin-right: auto;
  }

  /* Medium image - use ![alt|medium](/images/file.webp) */
  article img[alt*="|medium"] {
    width: 65%;
    max-height: 65%;
    margin-left: auto;
    margin-right: auto;
  }

  /* Large image - use ![alt|large](/images/file.webp) */
  article img[alt*="|large"] {
    width: 85%;
    max-height: 85%;
    margin-left: auto;
    margin-right: auto;
  }

  /* Left aligned - use ![alt|left](/images/file.webp) */
  article img[alt*="|left"] {
    float: left;
    margin: 8px 24px 16px 0;
  }

  /* Right aligned - use ![alt|right](/images/file.webp) */
  article img[alt*="|right"] {
    float: right;
    margin: 8px 0 16px 24px;
  }

  /* Center aligned (default) - use ![alt|center](/images/file.webp) */
  article img[alt*="|center"] {
    margin-left: auto;
    margin-right: auto;
  }

  /* Clear floats after floated images */
  article p:has(img[alt*="|left"]) + p,
  article p:has(img[alt*="|right"]) + p {
    clear: both;
  }

  /* Image caption styling - put text in italics right after image */
  article p img + br + em,
  article p:has(> img:only-child) + p em:only-child {
    display: block;
    text-align: center;
    color: #a1a1aa;
    font-size: 0.9rem;
    margin-top: -16px;
    margin-bottom: 24px;
  }
</style>