---
import MainLayout from "../../layouts/MainLayout.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import SearchForm from "../../components/SearchForm.astro";
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";

const rawQuery: string | null = Astro.url.searchParams.get('query');

if (!rawQuery || rawQuery.trim().length === 0) {
    return Astro.redirect('/articles');
}

const query: string = rawQuery.trim().toLowerCase();
const pageTitle = `Search Results: ${rawQuery}`;
const pageDescription = `Search results for "${rawQuery}" on ${Astro.site?.hostname ?? 'the site'}.`;

const allBlogArticles: CollectionEntry<'blog'> [] = await getCollection('blog');

const searchResults  = allBlogArticles.filter(article => {
    const titleMatch: boolean = article.data.title
    .toLowerCase()
    .includes(query);

    const bodyMatch: boolean = article.body
    .toLowerCase()
    .includes(query);

    const slugMatch: boolean = article.slug
    .toLowerCase()
    .includes(query);

    const descriptionMatch: boolean = (article.data.description ?? '')
    .toLowerCase()
    .includes(query);

    const tagMatch: boolean = article.data.tags
    .some(tag => tag.toLowerCase().includes(query));

    return titleMatch || bodyMatch || slugMatch || descriptionMatch || tagMatch;
}).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<MainLayout title={pageTitle} description={pageDescription} noindex={true}>
    <SearchForm />
    <h1 class="text-2xl pb-3 mt-6 text-white">Results for <strong>{rawQuery}</strong></h1>

    {searchResults.length === 0 ? (
        <div class="text-center py-12">
            <p class="text-lg text-muted">No articles matched "{rawQuery}".</p>
            <p class="text-sm text-muted mt-2">Try a different keyword, or browse everything instead.</p>
            <div class="flex flex-wrap justify-center gap-3 mt-6">
                <a href="/articles" class="inline-block bg-soft border border-soft text-white px-4 py-2 rounded-lg hover:border-accent hover:text-accent transition">All Articles</a>
                <a href="/articles/browse" class="inline-block bg-soft border border-soft text-white px-4 py-2 rounded-lg hover:border-accent hover:text-accent transition">Browse Categories</a>
            </div>
        </div>
    ) : (
        <div class="flex flex-col gap-4">
            {searchResults.map(article => (
                <ArticleCard article={article}/>
            ))}
        </div>
    )}
</MainLayout>