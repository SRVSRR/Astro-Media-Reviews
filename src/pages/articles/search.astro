---
import MainLayout from "../../layouts/MainLayout.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import SearchForm from "../../components/SearchForm.astro";
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";

const rawQuery: string | null = Astro.url.searchParams.get('query');

if (!rawQuery || rawQuery.trim().length === 0) {
    return Astro.redirect('/articles');
}

const query: string = rawQuery.trim().toLowerCase();
const pageTitle = `Search Results: ${rawQuery}`;
const pageDescription = `Search results for "${rawQuery}" on ${Astro.site?.hostname ?? 'the site'}.`;

const allBlogArticles: CollectionEntry<'blog'> [] = await getCollection('blog');

const searchResults  = allBlogArticles.filter(article => {
    const titleMatch: boolean = article.data.title
    .toLowerCase()
    .includes(query);

    const bodyMatch: boolean = article.body
    .toLowerCase()
    .includes(query);

    const slugMatch: boolean = article.slug
    .toLowerCase()
    .includes(query);

    return titleMatch || bodyMatch || slugMatch;
});
---

<MainLayout title={pageTitle} description={pageDescription} noindex={true}>
    <SearchForm />
    <h1 class="text-2xl pb-3 mt-6 text-white">Results for <strong>{rawQuery}</strong></h1>

    <div class="flex flex-col gap-4">
        {searchResults.map(article => ( 
            <ArticleCard article={article}/>
        ))}
    </div>
</MainLayout>