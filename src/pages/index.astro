---
import MainLayout from "../layouts/MainLayout.astro";
import SearchForm from "../components/SearchForm.astro";
import { HOMEPAGE_ARTICLE_LIMIT } from "../constants";
import ArticleCard from "../components/ArticleCard.astro";

import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";

const allBlogArticles: CollectionEntry<'blog'>[] = (await getCollection('blog')).sort((a: CollectionEntry <'blog'>, b:CollectionEntry<'blog'> )=> b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const recentArticles: CollectionEntry<'blog'>[] = allBlogArticles.slice(0, HOMEPAGE_ARTICLE_LIMIT);

const skills = [
  'Python',
  'JavaScript (Next.js)',
  'TypeScript',
  'Java (Spring Boot)',
  'SQL (PostgreSQL/MySQL)',
  'Git/GitHub',
];

const socials = [
  { label: 'GitHub', url: 'https://github.com/SRVSRR' },
  { label: 'LinkedIn', url: 'https://www.linkedin.com/in/rohan-nandan2004/' },
  { label: 'LeetCode', url: 'https://leetcode.com/u/SRVSRR/' },
];
---
<MainLayout
  title="Rohan Nandan - Data Scientist & Data Engineer"
  description="The portfolio and technical blog of Rohan Nandan, a Data Scientist / Data Engineer building end-to-end machine learning and full-stack products."
>
  <section class="flex flex-col lg:flex-row items-center gap-10 py-8">
    <div class="flex-1 text-center lg:text-left">
      <p class="text-sm uppercase tracking-[0.3em] text-accent">Data Scientist &amp; Data Engineer</p>
      <h1 class="text-4xl sm:text-5xl xl:text-6xl font-bold leading-tight text-white mt-3">
        Hey, I'm <span class="text-accent">Rohan Nandan</span>
      </h1>
      <p class="text-lg text-muted max-w-2xl mt-4 mx-auto lg:mx-0">
        I work across the full data science pipeline — from raw data to tested, deployed models — and
        pair that with software engineering to build real, usable products.
      </p>

      <div class="flex flex-wrap justify-center lg:justify-start gap-3 mt-6">
        <a href="/rohan-nandan-resume.pdf" target="_blank" rel="noopener noreferrer" class="inline-block bg-accent text-primary px-5 py-2.5 rounded-lg font-semibold hover:brightness-110 transition">Preview Resume</a>
        <a href="/about" class="inline-block bg-soft border border-soft text-white px-5 py-2.5 rounded-lg hover:border-accent hover:text-accent transition">About Me</a>
        <a href="/articles" class="inline-block bg-soft border border-soft text-white px-5 py-2.5 rounded-lg hover:border-accent hover:text-accent transition">Read the Blog</a>
      </div>

      <div class="flex flex-wrap justify-center lg:justify-start gap-3 mt-6">
        {socials.map(social => (
          <a href={social.url} target="_blank" rel="noopener noreferrer" class="text-sm text-muted hover:text-accent transition">{social.label}</a>
        ))}
      </div>
    </div>

    <div class="flex-1 w-full">
      <h2 class="text-xl font-semibold text-white mb-4 text-center lg:text-left">Skills</h2>
      <div class="flex flex-wrap gap-2">
        {skills.map(skill => (
          <span class="px-4 py-2 bg-secondary border border-soft rounded-full text-sm text-slate-100">{skill}</span>
        ))}
      </div>

      <div class="mt-8">
        <h2 class="text-xl font-semibold text-white mb-4 text-center lg:text-left">Highlighted Builds</h2>
        <div class="flex flex-col gap-3">
          <a href="https://github.com/SRVSRR/aog-zero" target="_blank" rel="noopener noreferrer" class="block bg-secondary border border-soft rounded-xl p-5 hover:border-accent transition">
            <h3 class="font-semibold text-white">AOG Zero</h3>
            <p class="text-muted text-sm mt-1">AI-powered real-time aircraft APU health monitoring and AOG prevention system. Next.js + FastAPI + Google OAuth.</p>
          </a>
          <a href="https://github.com/SRVSRR/student-administration-system" target="_blank" rel="noopener noreferrer" class="block bg-secondary border border-soft rounded-xl p-5 hover:border-accent transition">
            <h3 class="font-semibold text-white">Student Administration System</h3>
            <p class="text-muted text-sm mt-1">Full-stack system for managing staff, students, classes, enrollments, assessments, and PDF reports. Next.js + Spring Boot + PostgreSQL.</p>
          </a>
        </div>
      </div>
    </div>
  </section>

  <div class="mt-12 mb-6 flex items-center justify-between">
    <h2 class="text-2xl font-semibold text-white">Latest articles</h2>
    <a href="/articles" class="text-sm text-accent hover:underline">Browse all</a>
  </div>

  <SearchForm />

  <div class="mt-6 flex flex-col gap-4">
    {recentArticles.map(article => (
      <ArticleCard article={article} />
    ))}
  </div>
</MainLayout>
