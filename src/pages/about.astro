---
import MainLayout from "../layouts/MainLayout.astro";
import { Image } from "astro:assets";
import about from "../images/about.jpg";

// Projects - Your portfolio and project showcases
const projects = [
  {
    title: "2D Portfolio",
    description: "An interactive 2D pixel-art style portfolio showcasing my projects and skills in a unique retro gaming aesthetic.",
    url: "https://main--devportfolio2d.netlify.app",
    icon: "globe"
  },
];

// Social Links - Where to find me online
const socials = [
  {
    title: "GitHub",
    description: "Check out my open-source projects, contributions, and code repositories.",
    url: "https://github.com/SRVSRR",
    icon: "github"
  },
  {
    title: "LinkedIn",
    description: "Connect with me professionally.",
    url: "https://linkedin.com/in/rohan-nandan2004/",
    icon: "linkedin"
  },
  {
    title: "Reddit",
    description: "Follow me for tech thoughts and project updates",
    url: "https://www.reddit.com/user/SRVSRR/",
    icon: "reddit"
  },
];

// Featured Repositories
const repositories = [
  {
    title: "Student Administration System",
    description: "Full-stack student administration system with features for managing staff, students, classes, enrollments, assessments, and PDF report generation. ",
    url: "https://github.com/SRVSRR/student-administration-system",
  },
  {
    title: "AOG Zero",
    description: "Real-time AOG prevention system for aircraft APUs, featuring fleet-wide health monitoring, predictive alerts, and secure authentication",
    url: "https://github.com/SRVSRR/aog-zero",
  },
];
---

<MainLayout title="About">
  <!-- Hero About Section -->
  <div class="mb-16">
    <h1 class="text-5xl font-bold mb-8 text-white text-center">About Me</h1>
    
    <div class="flex flex-col lg:flex-row items-center gap-10 bg-secondary/50 rounded-2xl p-8 border border-soft">
      <!-- Profile Image -->
      <div class="w-full lg:w-1/3 flex-shrink-0">
        <div class="aspect-square w-full max-w-xs mx-auto bg-soft/20 rounded-2xl border-2 border-soft overflow-hidden shadow-xl">
          <Image src={about} alt="Rohan Nandan" class="w-full h-full object-cover" format="webp"/>
        </div>
      </div>
      
      <!-- About Content -->
      <div class="w-full lg:w-2/3">
        <h2 class="text-3xl font-extrabold text-white mb-4">
          Hey, I'm Rohan!
        </h2>
        
        <div class="space-y-4 text-muted leading-relaxed">
          <p>
            I'm a <span class="text-white font-medium">21-year-old Software Engineering student</span> passionate about building software and understanding what makes projects succeed. Currently diving deep into web development, system design, and agile methodologies.
          </p>
          
          <p>
            This blog is where I document my learning journey — sharing <span class="text-white font-medium">tutorials, project breakdowns, and insights</span> on software development and project management. From coding best practices to shipping products, I write about what I learn along the way.
          </p>
          
        </div>
      </div>
    </div>
  </div>

  <!-- Projects Section -->
  <div class="mb-16">
    <h2 class="text-3xl font-extrabold text-white mb-2 text-center">Projects</h2>
    <p class="text-muted text-center mb-10">Things I've built</p>
    
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {projects.map((project) => (
        <a 
          href={project.url} 
          target="_blank" 
          rel="noopener noreferrer"
          class="group block"
        >
          <div class="bg-secondary border border-soft rounded-xl p-6 transition-all duration-300 hover:border-white/30">
            <div class="flex items-start gap-3">
              <svg class="w-6 h-6 text-muted flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"></path>
              </svg>
              <div class="flex-1">
                <div class="flex items-center gap-2 mb-2">
                  <h3 class="text-lg font-semibold text-white group-hover:text-accent transition-colors">{project.title}</h3>
                </div>
                <p class="text-muted text-sm leading-relaxed">{project.description}</p>
              </div>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>

  <!-- Featured Repositories Section -->
  <div class="mb-16">
    <h2 class="text-3xl font-extrabold text-white mb-2 text-center">Featured Repositories</h2>
    <p class="text-muted text-center mb-10">Open source projects on GitHub</p>
    
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {repositories.map((repo) => (
        <a 
          href={repo.url} 
          target="_blank" 
          rel="noopener noreferrer"
          class="group block"
        >
          <div class="bg-secondary border border-soft rounded-xl p-6 transition-all duration-300 hover:border-white/30">
            <div class="flex items-start gap-3">
              <svg class="w-6 h-6 text-muted flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
              </svg>
              <div class="flex-1">
                <div class="flex items-center gap-2 mb-2">
                  <h3 class="text-lg font-semibold text-white group-hover:text-accent transition-colors">{repo.title}</h3>
                </div>
                <p class="text-muted text-sm leading-relaxed mb-3">{repo.description}</p>
              </div>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>

  <!-- Find Me Online Section -->
  <div class="mb-16">
    <h2 class="text-3xl font-extrabold text-white mb-2 text-center">Find Me Online</h2>
    <p class="text-muted text-center mb-10">Connect with me across the web</p>
    
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {socials.map((social) => (
        <a 
          href={social.url} 
          target="_blank" 
          rel="noopener noreferrer"
          class="group block"
        >
          <div class="bg-secondary border border-soft rounded-xl p-6 transition-all duration-300 hover:border-white/30">
            <div class="flex items-start gap-3">
              {social.icon === 'github' && (
                <svg class="w-6 h-6 text-muted flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                </svg>
              )}
              {social.icon === 'linkedin' && (
                <svg class="w-6 h-6 text-muted flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                </svg>
              )}
              {social.icon === 'reddit' && (
                <svg class="w-6 h-6 text-muted flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0zm5.01 4.744c.688 0 1.25.561 1.25 1.249a1.25 1.25 0 0 1-2.498.056l-2.597-.547-.8 3.747c1.824.07 3.48.632 4.674 1.488.308-.309.73-.491 1.207-.491.968 0 1.754.786 1.754 1.754 0 .716-.435 1.333-1.01 1.614a3.111 3.111 0 0 1 .042.52c0 2.694-3.13 4.87-7.004 4.87-3.874 0-7.004-2.176-7.004-4.87 0-.183.015-.366.043-.534A1.748 1.748 0 0 1 4.028 12c0-.968.786-1.754 1.754-1.754.463 0 .898.196 1.207.49 1.207-.883 2.878-1.43 4.744-1.487l.885-4.182a.342.342 0 0 1 .14-.197.35.35 0 0 1 .238-.042l2.906.617a1.214 1.214 0 0 1 1.108-.701zM9.25 12C8.561 12 8 12.562 8 13.25c0 .687.561 1.248 1.25 1.248.687 0 1.248-.561 1.248-1.249 0-.688-.561-1.249-1.249-1.249zm5.5 0c-.687 0-1.248.561-1.248 1.25 0 .687.561 1.248 1.249 1.248.688 0 1.249-.561 1.249-1.249 0-.687-.562-1.249-1.25-1.249zm-5.466 3.99a.327.327 0 0 0-.231.094.33.33 0 0 0 0 .463c.842.842 2.484.913 2.961.913.477 0 2.105-.056 2.961-.913a.361.361 0 0 0 .029-.463.33.33 0 0 0-.464 0c-.547.533-1.684.73-2.512.73-.828 0-1.979-.196-2.512-.73a.326.326 0 0 0-.232-.095z"/>
                </svg>
              )}
              <div class="flex-1">
                <div class="flex items-center gap-2 mb-2">
                  <h3 class="text-lg font-semibold text-white group-hover:text-accent transition-colors">{social.title}</h3>
                </div>
                <p class="text-muted text-sm leading-relaxed">{social.description}</p>
              </div>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</MainLayout>
