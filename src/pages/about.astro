---
import MainLayout from "../layouts/MainLayout.astro";
import { Image } from "astro:assets";
import about from "../images/about.jpg";
import team1 from "../images/team1.webp";
import team2 from "../images/team2.png";
---
<MainLayout title = "About">
        <h1 class="text-4xl font-bold mb-5 text-white"> About SRVSRR</h1>
        <div class="flex flex-col md:flex-row items-center justify-between gap-6">
          <div class="w-full md:w-1/2 mb-8 md:mb-0 max-w-2xl mx-auto">
            <div class="aspect-[4/3] md:aspect-[16/10] w-full bg-soft/20 rounded-lg border border-soft overflow-hidden">
              <Image src={about} alt="Tech People Team" class="w-full h-full object-cover" format="webp"/>
            </div>
          </div>
          <div class="w-full md:w-1/2">
            <h2 class="text-3xl font-extrabold text-white mb-4">
                  Hello There 👋
              </h2>
            <p class="text-muted leading-relaxed mb-6">
                  I am Rohan Nandan, a 20 year old currently in my first year of university studying Software Engineering. I made this website using Astro, a JavaScript web framework. 
              </p>
              <p class="text-muted leading-relaxed mb-6">
                My mission is to share the latest news, in-depth reviews, and engaging insights on whatever I’m exploring—expect the subjects to evolve with my interests.
            </p> 
          </div>
      </div>
      
      <!-- Team -->
      <div class="mt-10">
        <h2 class="text-3xl font-extrabold text-white mb-8">
          My Other Projects 
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-8">
          <a href="https://main--devportfolio2d.netlify.app">
          <div class="bg-secondary border border-soft rounded-lg overflow-hidden transition-transform duration-200 hover:-translate-y-1">
              <div class="aspect-[4/3] w-full bg-soft/20">
                <Image src={team1} alt="Team Member 1" class="w-full h-full object-cover" format="webp"/>
              </div>
              <div class="p-6">
                <h3 class="text-xl font-semibold text-white mb-2">2D Portfolio</h3>
              </div>
          </div>
        </a>
          <a href="https://github.com/SRVSRR">
          <div class="bg-secondary border border-soft rounded-lg overflow-hidden transition-transform duration-200 hover:-translate-y-1">
              <div class="aspect-[4/3] w-full bg-soft/20">
                <Image src={team2} alt="Team Member 2" class="w-full h-full object-cover" format="webp"/>
              </div>
              <div class="p-6">
                <h3 class="text-xl font-semibold text-white mb-2">GitHub</h3>
              </div>
          </div>
        </a>
        </div>
      </div>
  </MainLayout>