---
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import { capitalize } from "../utils";

const allBlogArticles: CollectionEntry<'blog'>[] = await getCollection('blog');

const tags: string[] = allBlogArticles.flatMap((article: any) => article.data.tags);

const uniqueTags: string[] = [...new Set(tags)];
---

<footer class="bg-secondary/80 border-t border-soft mt-16 text-slate-200">
  <div class="container mx-auto max-w-screen-xl px-6 sm:px-8 py-12">
    <div class="grid grid-cols-1 gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <div class="space-y-3">
        <h3 class="text-xl font-semibold text-white">About</h3>
        <p class="text-sm text-muted leading-relaxed">
          SRVSRR is where I share my journey in software development.
      </div>
      <div>
        <h3 class="text-xl font-semibold text-white mb-4">Categories</h3>
        <ul class="text-sm space-y-2 text-muted">
          {uniqueTags.map(tag => (
            <li>
              <a class="hover:text-accent transition" href={'/articles/tag/' + tag}>{capitalize(tag)}</a>  
            </li>
          ))}
        </ul>
      </div>
      <div>
        <h3 class="text-xl font-semibold text-white mb-4">Socials</h3>
        <ul class="text-sm space-y-2 text-muted">
          <li><a class="hover:text-accent transition" href="https://github.com/SRVSRR">GitHub</a></li>
          <li><a class="hover:text-accent transition" href="https://www.instagram.com/rohan_nandan_/">Instagram</a></li>
          <li><a class="hover:text-accent transition" href="https://www.linkedin.com/in/rohan-nandan2004/">LinkedIn</a></li>
          <li><a class="hover:text-accent transition" href="https://www.reddit.com/user/SRVSRR/">Reddit</a></li>
        </ul>
      </div>
      <div>
        <h3 class="text-xl font-semibold text-white mb-4">My Other Projects</h3>
        <ul class="text-sm space-y-2 text-muted">
          <li><a class="hover:text-accent transition" href="https://main--devportfolio2d.netlify.app">2D Portfolio</a></li>
        </ul>
      </div>
    </div>
    <div class="mt-10 flex flex-wrap items-center justify-between gap-4 text-xs text-muted">
      <span>© {new Date().getFullYear()} SRVSRR. All opinions are my own.</span>
      <span class="text-white">Crafted with Astro · Deployed on Vercel</span>
    </div>
  </div>
</footer>