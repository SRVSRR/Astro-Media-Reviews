---
const { currentPage, totalPages, disablePrevious, disableNext } = Astro.props;

interface Props {
  currentPage: number;
  totalPages: number;
  disablePrevious: boolean;
  disableNext: boolean;
}
---
<!-- Pagination -->
<div class="flex flex-col items-center gap-4 mt-10">
  <div class="flex justify-between items-center w-full">
    <a href={'/articles?page=' + (currentPage - 1)} class={disablePrevious ? "inline-block bg-secondary/60 px-4 py-2 text-muted rounded-lg pointer-events-none border border-soft" : "inline-block bg-soft px-4 py-2 text-white rounded-lg border border-soft hover:border-accent hover:text-accent transition"}>
      Previous
    </a>
    <span class="text-sm text-muted">Page {currentPage} of {totalPages}</span>
    <a href={'/articles?page=' + (currentPage + 1)}
     class={disableNext ? "inline-block bg-secondary/60 px-4 py-2 text-muted rounded-lg pointer-events-none border border-soft" : "inline-block bg-soft px-4 py-2 text-white rounded-lg border border-soft hover:border-accent hover:text-accent transition"}>
      Next
    </a>
  </div>
  
  {totalPages > 2 && (
    <form id="page-jump-form" class="flex items-center gap-2">
      <label for="page-input" class="text-sm text-muted">Go to page:</label>
      <input 
        type="number" 
        id="page-input" 
        name="page" 
        min="1" 
        max={totalPages} 
        value={currentPage}
        class="w-16 px-2 py-1 text-sm text-white bg-secondary border border-soft rounded-lg focus:border-accent focus:outline-none text-center"
      />
      <button 
        type="submit" 
        class="px-3 py-1 text-sm bg-soft text-white rounded-lg border border-soft hover:border-accent hover:text-accent transition"
      >
        Go
      </button>
    </form>
  )}
</div>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('page-jump-form');
    const input = document.getElementById('page-input');
    
    if (form && input) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const page = parseInt(input.value);
        const max = parseInt(input.max);
        const min = parseInt(input.min);
        
        if (page >= min && page <= max) {
          window.location.href = '/articles?page=' + page;
        }
      });
    }
  });
</script>