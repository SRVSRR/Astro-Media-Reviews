---
import { capitalize, slugify } from '../utils';

const { tags } = Astro.props;

interface Props {
  tags: string[];
}
---

<div class="flex flex-wrap gap-2">
  {tags.map((tag: string) => (
  <span
  class="px-3 py-1 bg-soft text-white/90 rounded-full text-xs border border-white/10 hover:border-accent hover:text-accent transition"
  ><a class="tag-link" href={'/articles/tag/' + slugify(tag)}>#{capitalize(tag)}</a></span>
  ))}
 </div>