---
import { Image } from "astro:assets";
import logo from '../images/logo.png';
---
<nav class="sticky top-0 z-40 backdrop-blur bg-secondary/80 border-b border-soft/60">
  <div class="max-w-screen-xl flex flex-wrap items-center justify-between mx-auto px-4 py-3">
    <a href="/" class="flex items-center gap-3 hover:opacity-90 transition">
      <Image src={logo} class="h-12 w-auto" alt="SRVSRR Logo" width={55} height={55}/>
      <span class="text-2xl font-semibold tracking-tight text-white">
        <span class="text-accent">SRV</span>SRR
      </span>
    </a>

    <div class="flex items-center gap-3 text-sm text-muted">
      <span class="hidden sm:inline">Curated by interest</span>
      <div class="hidden sm:block h-7 w-px bg-soft" aria-hidden="true"></div>
      <div class="flex items-center gap-1 text-accent font-medium">
        <span class="inline-block h-2 w-2 rounded-full bg-accent animate-pulse" aria-hidden="true"></span>
        <span>Fresh takes weekly</span>
      </div>
    </div>

    <div class="w-full mt-4 md:mt-0 md:w-auto">
      <ul class="flex flex-col md:flex-row md:items-center md:gap-6 text-sm font-medium text-white">
        <li><a href="/" class="hover:text-accent transition-colors">Home</a></li>
        <li><a href="/articles" class="hover:text-accent transition-colors">All Articles</a></li>
        <li><a href="/about" class="hover:text-accent transition-colors">About</a></li>
      </ul>
    </div>
  </div>
</nav>
