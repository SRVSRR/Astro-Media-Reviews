<form id="search-form" class="flex items-center" action="/articles/search">
    <label for="search-input" class="sr-only">Search</label>
    <div class="relative w-full">            
      <input
        type="text"
        id="query"
        name="query"
        class="bg-secondary/80 border border-soft text-slate-100 text-sm rounded-lg focus:ring-accent focus:border-accent block w-full p-3 placeholder:text-muted"
        placeholder="Search articles..."
        required
      />
    </div>
    <button
      type="submit"
      class="p-3 ms-2 text-sm font-semibold text-white bg-accent rounded-lg border border-accent hover:brightness-110 transition"
    >
      <svg
        class="w-4 h-4"
        aria-hidden="true"
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 20 20"
      >
        <path
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="m19 19-4-4m0-7A7 7 0 1 1 1 8a7 7 0 0 1 14 0Z"
        />
      </svg>
      <span class="sr-only">Search</span>
    </button>
  </form>