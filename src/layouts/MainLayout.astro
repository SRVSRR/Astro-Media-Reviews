---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import  SpeedInsights  from "@vercel/speed-insights/astro"
import Analytics from "@vercel/analytics/astro";

import { SITE_TITLE, SITE_DESCIPTION } from '../constants';

const { title = 'Blogs, Reviews and News'} = Astro.props;

interface Props {
    title?: string;
}
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" href="/file.svg" type="image/svg+xml" sizes="any" />
    <link rel="shortcut icon" href="/file.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/file.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={SITE_DESCIPTION} />
    <meta name="google-site-verification" content="PSZNQJwIQqBeaCpv_Klld7nAnK0sNLNuSVnSkqhcALc" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Space+Grotesk:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{SITE_TITLE} - {title}</title>
  </head>
  <body class="bg-gradient-to-b from-primary via-soft to-primary text-slate-100 min-h-screen font-sans">
    <Navbar />
    <section class="container mx-auto max-w-screen-xl mt-10 px-6 sm:px-8">
        <slot />
    </section>
    <Footer />
    <SpeedInsights />
    <Analytics />
    </body>
  </html>